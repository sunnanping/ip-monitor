# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# 不提交敏感测试数据
*.yaml
*.json

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Build output
ip-monitor
ip-monitor.exe

# Debug log files
debug.log

# Configuration files with sensitive information
# config.yaml

# Run records
run_record.json

# IDE specific files
.idea/
*.swp
*.swo
*~

# VSCode settings (but allow launch.json and tasks.json)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# OS specific files
.DS_Store
Thumbs.db


